# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=./keys.json
SPREADSHEET_ID=

# Banco do Brasil
BB_AGENCIA=
BB_CONTA=
BB_SENHA=

# Caixa (senha = posições das teclas no teclado virtual, ex: 31415926)
CAIXA_USUARIO=
CAIXA_SENHA=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_NUMBER=

# Gmail (gere uma senha de app em https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_DESTINATARIO=
